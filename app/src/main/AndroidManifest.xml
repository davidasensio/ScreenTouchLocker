<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScreenTouchLocker"
        tools:targetApi="31">

        <activity
            android:name="com.handysparksoft.screentouchlocker.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.ScreenTouchLocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.handysparksoft.screentouchlocker.ScreenTouchLockerTileService"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_screen_locker_icon"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>

            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!--
        specialUse (not mediaProcessing): the app performs no media work, and mediaProcessing
        carries a hard 6h/24h runtime limit that ANRed this always-on service.
        -->
        <service
            android:name="com.handysparksoft.screentouchlocker.ScreenTouchLockerService"
            android:enabled="true"
            android:exported="false"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent user-controlled screen-touch lock overlay, toggled from its ongoing notification and Quick Settings tile" />
        </service>

        <service
            android:name="com.handysparksoft.screentouchlocker.ShakeDetectorService"
            android:enabled="true"
            android:exported="false" />

        <!--
        Only BOOT_COMPLETED is exempt from the background FGS start restrictions.
        USER_PRESENT (every unlock) and REBOOT were not, and threw
        ForegroundServiceStartNotAllowedException once the app targeted API 35+.
        -->
        <receiver
            android:name="com.handysparksoft.screentouchlocker.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

